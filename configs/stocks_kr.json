{
  "id": "stocks_kr",
  "title": "KOSPI · 업종별 대형주 (sample)",
  "adapter": "yfinance",
  "mode": "delayed",
  "source": "Yahoo Finance via yfinance (unofficial) · polled every 60s · KRX quotes delayed",
  "note": "업종 분류는 이 config의 수작업 그룹이며 공식 KRX 업종이 아님. Edges = residual correlation of 5-minute returns.",
  "labels": {
    "value": "price (KRW)",
    "energy": "session trading value (KRW)",
    "delta_ref": "전일 대비",
    "delta_win": "30분 변화",
    "delta_kind": "pct",
    "edges": "residual corr · 5m returns · ~5 sessions",
    "volume": "bar dollar volume"
  },
  "view": {
    "size_scale": "sqrt",
    "delta_clip": {
      "ref": 0.04,
      "win": 0.01
    },
    "default_delta": "ref"
  },
  "engine": {
    "bucket_s": 300,
    "corr_window": 390,
    "corr_min": 60,
    "edge_mode": "residual",
    "edge_top_k": 3,
    "edge_min_abs": 0.2,
    "sector_edge_min_abs": 0.15,
    "delta_window_s": 1800,
    "clock": "data",
    "hawkes": {
      "tau_short_s": 1800,
      "tau_long_s": 86400,
      "alpha": 1.0,
      "floor_per_s": 1e-05
    },
    "event": {
      "z_vol": 3.0,
      "z_ret": 3.0,
      "halflife_obs": 78,
      "warm": 20
    }
  },
  "adapter_options": {
    "period": "5d",
    "interval": "5m",
    "bar_minutes": 5,
    "poll_s": 60,
    "backfill_period": "60d",
    "live_days": 5
  },
