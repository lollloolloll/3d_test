{
  "id": "kidak",
  "title": "Kidak market · AI 키보드 · 말투/답장 AI (daily)",
  "adapter": "kidak",
  "mode": "daily",
  "source": "App Store iTunes Lookup + review RSS (kr) · Naver DataLab search trend (optional, env keys) · Google Play planned",
  "note": "Slow proxy signals, collected daily. Cell size = App Store rating count (log scale). Colour = recent-review mean minus lifetime rating. Pulse = review-arrival Hawkes burst. Ring = how many of the 4 sources feed the app. No Instagram / X data. Grouping and app list are a hand-made config.",
  "primary_source": "appstore_lookup",
  "default_sources": ["appstore_lookup", "appstore_reviews", "naver_trend", "google_play"],
  "labels": {
    "value": "avg rating (★)", "energy": "rating count",
    "delta_ref": "recent 50 reviews − lifetime ★", "delta_win": "7d change", "delta_kind": "abs", "delta_win_kind": "pct",
    "edges": "corr of daily Naver search index (needs keys + ≥20 days)"
  },
  "view": {"size_scale": "log", "delta_clip": {"ref": 1.0, "win": 0.1}, "default_delta": "ref"},
  "replay": {"source": "appstore_reviews", "value": "mean", "energy": "count", "grains": ["1d"],
             "note": "replay = daily mean ★ of dated reviews; energy = reviews that day (App Store RSS keeps only the latest ≤500)"},
  "engine": {
    "bucket_s": 86400, "corr_window": 90, "corr_min": 20, "edge_mode": "raw", "corr_source": "naver_trend",
    "edge_top_k": 3, "edge_min_abs": 0.4, "sector_edge_min_abs": 0.3,
    "delta_window_s": 604800, "clock": "wall",
    "hawkes": {"tau_short_s": 259200, "tau_long_s": 2592000, "alpha": 1.0, "floor_per_s": 0.0000001},
    "event": {"z_vol": 3.0, "z_ret": 3.0, "halflife_obs": 20, "warm": 10},
    "phase": {"M_on": 0.7, "B_on": 2.0, "M_off": 0.5, "B_off": 1.3, "min_members": 3}
  },
  "adapter_options": {"country": "kr", "refresh_s": 86400, "rss_pages": 10, "naver_start": "2016-01-01", "naver_anchor": ["맞춤법 검사기"]},
  "sectors": [
